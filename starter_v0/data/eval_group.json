{
  "dataset_id": "day03_v2_research_group",
  "dataset_role": "group",
  "description": "Bộ 10 eval cases của nhóm: 5 single-turn + 5 multi-turn, kiểm tra routing cả 2 tool mới (calculator, save_note), timeframe, clarify, boundary confirm.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
