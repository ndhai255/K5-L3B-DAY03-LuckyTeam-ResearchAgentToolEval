  "cases": [
    {
      "id": "G01_calculator_routing",
      "phase": "B",
      "suite": "group",
      "query": "Tính giúp mình giá trị của biểu thức: (120 - 80) * 5 / 2",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "calculator",
            "args": {
              "expression": "(120 - 80) * 5 / 2"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_calculator",
        "difficulty": "easy",
        "what_it_tests": "Route đến tool calculator khi có biểu thức toán học cần tính toán."
      }
    },
    {
